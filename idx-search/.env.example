# MLS GRID API
MLSGRID_ACCESS_TOKEN=your_mlsgrid_access_token_here
MLSGRID_ORIGINATING_SYSTEM=actris

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# JWT Secret (use a long random string)
JWT_SECRET=your_very_long_random_secret_here_change_this

# Admin credentials (your realtor account)
ADMIN_EMAIL=you@austintxhomes.co

# Email (for saved search alerts) — works with Gmail, SendGrid, any SMTP
# For Gmail: set EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, use an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM_NAME=Luke Allen
EMAIL_FROM=you@austintxhomes.co

# Public URL of your site (used in alert email links)
SITE_URL=https://austintxhomes.co

# Server
PORT=3000

# Realtor-OS (CRM) integration — optional
# When both are set, the admin "Build search for client" modal shows a
# live Realtor-OS contact picker, and new clients created on this site
# are mirrored back to Realtor-OS as contacts. If unset, the admin can
# still create clients manually; the integration just stays dark.
# Expected Realtor-OS endpoints (server-to-server, X-Internal-API-Key):
#   GET  /api/internal/contacts?q=<query>&limit=20  -> [{id,name,email,phone}]
#   GET  /api/internal/contacts/:id                 -> {id,name,email,phone}
#   POST /api/internal/contacts                     -> {id,name,email,phone}
REALTOR_OS_URL=
REALTOR_OS_INTERNAL_KEY=
